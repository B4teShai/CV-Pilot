      "boundElements": null,
      "updated": 0,
      "link": null,
      "locked": false,
      "text": "Arrows point from caller to callee. Built: the CLI, the local run store, framework hooks, tracker forwarders, alert channels (webhook, Slack, Telegram) and checkpoint mirrors to object storage; the server, SMTP and sync are planned.",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Arrows point from caller to callee. Built: the CLI, the local run store, framework hooks, tracker forwarders, alert channels (webhook, Slack, Telegram) and checkpoint mirrors to object storage; the server, SMTP and sync are planned.",
      "autoResize": true,
      "lineHeight": 1.25
    },
