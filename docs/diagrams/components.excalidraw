      "updated": 0,
      "link": null,
      "locked": false,
      "text": "Solid arrow = direct import. Dashed arrow = adapter resolved through a registry by name at run time. Same-lane calls (runs/ -> alerts/, ckpt/ -> runs/) and infrastructure -> domain imports are not drawn.",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Solid arrow = direct import. Dashed arrow = adapter resolved through a registry by name at run time. Same-lane calls (runs/ -> alerts/, ckpt/ -> runs/) and infrastructure -> domain imports are not drawn.",
      "autoResize": true,
      "lineHeight": 1.25
    },
